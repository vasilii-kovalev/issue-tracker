generator client {
  provider     = "prisma-client"
  output       = "../src/db/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Permission {
  createdDate DateTime @default(now())
  // Format: `resource:action:scope`.
  id          String   @id
  roles       Role[]
  updatedDate DateTime @updatedAt
}

model Role {
  createdDate DateTime     @default(now())
  description String
  id          String       @id
  permissions Permission[]
  updatedDate DateTime     @updatedAt
  users       User[]
}

model User {
  createdDate DateTime @default(now())
  email       String   @unique
  id          String   @id @default(cuid())
  name        String   @unique
  password    String
  roles       Role[]
  updatedDate DateTime @updatedAt
}
