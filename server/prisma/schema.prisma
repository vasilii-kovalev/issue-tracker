generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Permission {
  id          String   @id
  // User, project, issue, etc.
  resource    String
  // Create, read, update, delete.
  action      String
  // Own, any.
  scope       String
  roles       Role[]
  createdDate DateTime @default(now())
  updatedDate DateTime @updatedAt

  @@unique([resource, action, scope])
}

model Role {
  id          String       @id
  permissions Permission[]
  users       User[]
  createdDate DateTime     @default(now())
  updatedDate DateTime     @updatedAt
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  displayedName String
  password      String
  roles         Role[]
  createdDate   DateTime @default(now())
  updatedDate   DateTime @updatedAt
}
