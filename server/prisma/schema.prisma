generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Permission {
  // Create, read, update, delete.
  action      String
  createdDate DateTime @default(now())
  id          String   @id
  // User, project, issue, etc.
  resource    String
  roles       Role[]
  // Own, any.
  scope       String
  updatedDate DateTime @updatedAt

  @@unique([resource, action, scope])
}

model Role {
  createdDate DateTime     @default(now())
  id          String       @id
  permissions Permission[]
  updatedDate DateTime     @updatedAt
  users       User[]
}

model User {
  createdDate DateTime @default(now())
  email       String   @unique
  id          String   @id @default(cuid())
  name        String   @unique
  password    String
  roles       Role[]
  updatedDate DateTime @updatedAt
}
