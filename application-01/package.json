{
	"name": "application-01",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"main": "./src/main.tsx",
	"scripts": {
		"dev": "bunx --bun vite",
		"build": "bunx --bun vite build",
		"preview": "bunx --bun vite preview",
