		"eslint-plugin-react-hooks": "5.1.0",
		"eslint-plugin-react-refresh": "0.4.16",
		"eslint-plugin-simple-import-sort": "12.1.1",
		"globals": "15.14.0",
		"stylelint": "16.12.0",
		"stylelint-order": "6.0.4",
		"typescript": "5.7.2",
		"typescript-eslint": "8.19.0",
		"vite": "6.0.6",
		"vite-tsconfig-paths": "5.1.4"
	}
